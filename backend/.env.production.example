# HostelEaseApp - Production Environment Variables
# Copy this file to .env and fill in your actual values

# Application
NODE_ENV=production
PORT=5000

# Database
MONGO_URI=mongodb://your-mongo-host:27017/hostel-ease
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/hostel-ease

# JWT Authentication
JWT_SECRET=e8cf765e905915acee624fa2fef53d928322885941f3f0750634a14f83c55797e582daf6dd1512cb529bf23a7a498b1c5fc9d4d786217b62eb4f08d29d24e004
JWT_EXPIRE=30d

# Google Gemini AI
GEMINI_API_KEY=AIzaSyBjz0g45p4j9AXLhovHylIcgNtm-8qmRjA

# CORS
CORS_ORIGIN=https://yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload (Optional)
MAX_FILE_SIZE=10485760

# Email (Optional - for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Frontend URL (for CORS and redirects)
FRONTEND_URL=https://yourdomain.com

# Socket.IO
SOCKET_CORS_ORIGIN=https://yourdomain.com
